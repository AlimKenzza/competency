# Скопируйте в .env и при необходимости измените

# База данных (по умолчанию SQLite). Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/competency

# Путь к дообученной модели (опционально)
# FINETUNED_MODEL_PATH=/path/to/model

# Пороги сопоставления
# THRESHOLD_FULL=0.85
# THRESHOLD_PARTIAL=0.65
# THRESHOLD_RELATED=0.45
